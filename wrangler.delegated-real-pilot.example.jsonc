{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Preparation only: replace every marker after verifying the real AFW resource.
  // Never deploy using the synthetic canary's KV, client, Access audience or issuer.
  "account_id": "85d0d5dadac3341a564f22ce885e9eec",
  "name": "replace-with-verified-afw-worker-name",
  "main": "worker/delegated/index.mjs",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "AFW_DELEGATED_OAUTH_ENABLED": "false",
    "AFW_OAUTH_REFRESH_ENABLED": "false",
    "AFW_OAUTH_ISSUER": "https://replace-with-verified-origin.example.invalid",
    "AFW_OAUTH_RESOURCE": "https://replace-with-verified-origin.example.invalid/mcp",
    "AFW_OAUTH_PILOT_CLIENT_ID": "replace-with-verified-real-pilot-client",
    "AFW_OAUTH_PILOT_PROJECT_ID": "replace-with-explicitly-selected-owner-project",
    "AFW_OAUTH_PILOT_EXPIRES_AT": "replace-with-absolute-deadline",
    "ACCESS_TEAM_DOMAIN": "tokenizart.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-verified-delegated-real-pilot-audience"
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "replace-with-separate-verified-kv-id" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "agent-friendly-web-web-production",
    "database_id": "d26fc9d2-df5a-4957-8e58-cc4c945faad8"
  }],
  "ratelimits": [{ "name": "DELEGATED_RATE_LIMITER", "namespace_id": "replace-with-verified-rate-namespace", "simple": { "limit": 30, "period": 60 } }]
}
