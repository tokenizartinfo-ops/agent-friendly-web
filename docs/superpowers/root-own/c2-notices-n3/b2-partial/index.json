      "selectionHash",
      "contractHash",
      "schemaHash",
      "seamsHash",
      "vectorsHash",
      "driverHash",
      "coupledHash",
      "worldHash",
      "helperHash",
      "readerHash",
      "loggerHash",
      "slotHash",
      "ledgerHash",
      "transformHash"
    ],
    "protocolHashesKeys": [
      "contractHash",
      "schemaHash",
      "seamsHash"
    ],
    "policy": "requiredSteps ordered unique names and commandStep included; final actual step policy is caller-bound and pending Source workflow/runner pins",
