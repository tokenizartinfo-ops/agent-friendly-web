{"schema":"AFW.GET_WINNER.REVERSIBLE_LITERAL/1","preimage":"b2b6f6c7e13f6b5f4a1275546f4294c1402b6ce4","after":{"path":"docs/superpowers/source-lab/c2-get-winner-dependent/body-09-fixed-fault-tool.txt","mode":"100644","type":"blob","kind":"TEST_ONLY_COMPILER_AFTERIMAGE","blob":"d5ac46935496f26ecc64d60c1b94e1bbf4efad61","bytes":85130,"sha256":"4ab7257c682a1f6220051228ec322838d488a168aa94f449e40b2ab318a434d6","fullReadback":true},"operations":[{"offset":10978,"before":"export async function compileFirstConnectionCandidate(revision,tree,{negativeProfile=false,budgetQualification=false,dropWinner=false,getWinner=false}={}){\n","after":"export async function compileFirstConnectionCandidate(revision,tree,{negativeProfile=false,budgetQualification=false,dropWinner=false,getWinner=false,toolFault=null}={}){\n"},{"offset":11276,"before":"","after":" let faultRow=null;const faultState={hits:0};\n if(toolFault!==null){\n  assert(dropWinner&&!negativeProfile&&!budgetQualification);\n  const raw=await readFile('fixed-m-fault-seams.json','utf8');\n  assert.equal(digest(raw),'66d2f0a483d54dfe0e694a94b24f6ec448751371036a1ca6354018c5f5eb82f2');\n  const manifest=JSON.parse(raw);\n  faultRow=manifest.rows.find(row=>row.fault===toolFault&&row.enabled===getWinner);assert(faultRow);\n }\n"},{"offset":12295,"before":" const m=await build({...options,entryPoints:['worker/mcp-own/finite.mjs'],...budget?{plugins:[budget.plugin()]}:getWinner?{plugins:[getWinnerPlugin()]}:dropWinner?{plugins:[dropMPlugin()]}:{}});\n","after":" const m=await build({...options,entryPoints:['worker/mcp-own/finite.mjs'],...budget?{plugins:[budget.plugin()]}:getWinner?{plugins:[getWinnerPlugin(faultRow,faultState)]}:dropWinner?{plugins:[dropMPlugin(faultRow,faultState)]}:{}});\n if(faultRow)assert.equal(faultState.hits,1);\n"},{"offset":16414,"before":" return {...budget?{budget:budget.records()}: {},script:m.outputFiles[0].text,bytes,program:node.program,resident,metafile:m.metafile,spyScript:spy.outputFiles[0].text,spyHash:digest(spy.outputFiles[0].contents),wrongProfileScript:wrong?.outputFiles[0].text??null,wrongProfileHash:wrong?digest(wrong.outputFiles[0].contents):null};\n","after":" return {...faultRow?{toolFault:{id:faultRow.id,enabled:getWinner,name:faultRow.name,preimageSha256:faultRow.preimage.sha256,afterSha256:faultRow.after.sha256,afterBytes:faultRow.after.bytes}}:{},...budget?{budget:budget.records()}: {},script:m.outputFiles[0].text,bytes,program:node.program,resident,metafile:m.metafile,spyScript:spy.outputFiles[0].text,spyHash:digest(spy.outputFiles[0].contents),wrongProfileScript:wrong?.outputFiles[0].text??null,wrongProfileHash:wrong?digest(wrong.outputFiles[0].contents):null};\n"},{"offset":70182,"before":"function dropMPlugin() {\n","after":"function dropMPlugin(faultRow=null,faultState=null) {\n"},{"offset":70462,"before":"      const contents=prepareDropM(name,await readFile(args.path,'utf8'));const pins={\"worker/mcp-own/finite.mjs\":\"922428af9ac17d0f11ad2928c8ad60b88b8b78fa8729cafd512e407d2ec9ab67\",\"lib/mcp-qa-finite-owner-native-bridge.mjs\":\"97856b44f9b46f4110cb3e23e85d047cae895d2f39ed6d027c528f9a1c373633\",\"lib/mcp-qa-finite-owner-native-wire.mjs\":\"d0b88ce5a6319ff7559f13cda5d9aea6be6bb226fc775422547abce923bab3fe\"};assert.equal(digest(contents),pins[name],'prepared M input');return {contents,loader:'js'};\n","after":"      const contents=prepareDropM(name,await readFile(args.path,'utf8'));const pins={\"worker/mcp-own/finite.mjs\":\"922428af9ac17d0f11ad2928c8ad60b88b8b78fa8729cafd512e407d2ec9ab67\",\"lib/mcp-qa-finite-owner-native-bridge.mjs\":\"97856b44f9b46f4110cb3e23e85d047cae895d2f39ed6d027c528f9a1c373633\",\"lib/mcp-qa-finite-owner-native-wire.mjs\":\"d0b88ce5a6319ff7559f13cda5d9aea6be6bb226fc775422547abce923bab3fe\"};assert.equal(digest(contents),pins[name],'prepared M input');return {contents:applyFixedGetFault(name,contents,faultRow,faultState),loader:'js'};\n"},{"offset":81390,"before":"function getWinnerPlugin() {\n","after":"function getWinnerPlugin(faultRow=null,faultState=null) {\n"},{"offset":82184,"before":"      return {contents:prepareGetWinner(name,prepared),loader:'js'};\n","after":"      return {contents:applyFixedGetFault(name,prepareGetWinner(name,prepared),faultRow,faultState),loader:'js'};\n"},{"offset":84442,"before":"","after":"\n/** Separate fixed TOOL compiler only. Never mounted as Source13 or ordinary M compiler. */\nfunction applyFixedGetFault(name,source,row,state){\n if(!row||row.name!==name)return source;\n assert.equal(state.hits++,0);\n assert.equal(Buffer.byteLength(source),row.preimage.bytes);assert.equal(digest(source),row.preimage.sha256);\n assert.equal(row.operations.length,1);\n const op=row.operations[0];assert.equal(source.slice(op.offset,op.offset+op.before.length),op.before);\n const changed=source.slice(0,op.offset)+op.after+source.slice(op.offset+op.before.length);\n assert.equal(Buffer.byteLength(changed),row.after.bytes);assert.equal(digest(changed),row.after.sha256);\n return changed;\n}\n"}],"forwardReverseExact":true,"canonicalToolPath":"test/fixtures/finite-first-get-fault-tool.mjs","scope":"Tool-only compiler copy. Fixed compile-time six-row table; exactly one prepared-source seam applied to M, all other module bytes ordinary. No product selector or runtime hook. Product Source13 S09 remains b2b6... .","execution":"DATA only"}
