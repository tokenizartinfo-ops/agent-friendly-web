{"schema":"AFW.GET_WINNER.REVERSIBLE_LITERAL/1","unit":"UTF16 code unit offset; sequential literal replacements; reverse in reverse order","authority":"dc132c7946534f5fbbf321b0801ad60e4afb7549","rows":[{"preimage":"14b1a67b0557dbc660a3900d8767b40c5bff7755","after":{"path":"docs/superpowers/source-lab/c2-get-winner-dependent/body-08-get-winner.txt","mode":"100644","type":"blob","kind":"DRAFT_SOURCE_AFTERIMAGE","blob":"e488965a58b989aa1c2f05a16aa6d5b74d4e411a","bytes":23226,"sha256":"75ff602cecc209575fb967e63469facbbb47ef6335a2a1ccad66710225002046","fullReadback":true},"operations":[{"offset":41,"before":"import {createHash} from 'node:crypto';\n","after":"import {createHash} from 'node:crypto';import {Response as DispatchResponse} from 'miniflare';\n"},{"offset":206,"before":"import {plain,approveFirstConnection,readFirstConnectionProbe} from './finite-first-connection-publication.mjs';\n","after":"import {plain,approveFirstConnection,readFirstConnectionProbe,createGetWinnerHost} from './finite-first-connection-publication.mjs';\n"},{"offset":1701,"before":"async function choose(f){\n const r=await f.call('/connections/finite-prepare',{headers:headers(f)}),status=r.status,text=await r.text();assert.equal(status,200);\n","after":"async function choose(f,get=null){\n const r=await f.call('/connections/finite-prepare',{headers:headers(f)}),status=r.status,text=await r.text();get?.capture(f,r,status);assert.equal(status,200);\n"},{"offset":14758,"before":"   const f=main,form=await choose(f),snapshot=await plain(f.stub.c2Snapshot()),before=await count(f);assert(form.text.includes('revocar únicamente la concesión OAuth creada aquí.'));\n","after":"   const f=main,form=await choose(f,observer.getToken(label)),snapshot=await plain(f.stub.c2Snapshot()),before=await count(f);assert(form.text.includes('revocar únicamente la concesión OAuth creada aquí.'));\n"},{"offset":21944,"before":"","after":" const get=createGetWinnerHost(main,()=>main.getWinnerDirect?.()===true,DispatchResponse);let getToken=null;\n"},{"offset":22232,"before":"  pending={id};state='active';return pending;\n","after":"  pending={id};state='active';if(id==='C2T1_SCOPE_MISSING')getToken=get.begin(pending);return pending;\n"},{"offset":22364,"before":"  if(state==='active'&&label===pending)state='ready';\n  else {state='poisoned';pending=null;}\n","after":"  if(state==='active'&&label===pending){state='ready';if(label.id==='C2T1_SCOPE_MISSING')get.finish(label);}\n  else {state='poisoned';pending=null;get.poison();}\n"},{"offset":22578,"before":"  if(state==='active'){state='poisoned';pending=null;}\n","after":"  if(state==='active'){state='poisoned';pending=null;get.poison();}\n"},{"offset":22881,"before":"   try{emit('C2FT3 '+JSON.stringify({id:label.id,value}));}catch{}\n","after":"   try{\n    if(label.id==='C2T1_SCOPE_MISSING') {\n     const winner=get.take(label,active)??{w:'U',s:0,h:0};\n     emit('C2FT4 '+JSON.stringify({id:label.id,value,...winner}));\n    } else emit('C2FT3 '+JSON.stringify({id:label.id,value}));\n   }catch{}\n"},{"offset":23141,"before":" return {enter,finish,counts};\n","after":" return {enter,finish,counts,getToken:label=>label===pending?getToken:null};\n"}]},{"preimage":"9da84b3f0606e9cb84d8308de26c7f193c5c778a","after":{"path":"docs/superpowers/source-lab/c2-get-winner-dependent/body-09-get-winner.txt","mode":"100644","type":"blob","kind":"DRAFT_SOURCE_AFTERIMAGE","blob":"b2b6f6c7e13f6b5f4a1275546f4294c1402b6ce4","bytes":83571,"sha256":"a615fbc760cd3a6b3a337a4592196d3cd807650df875865f0f8204f2d4d73f80","fullReadback":true},"operations":[{"offset":10978,"before":"export async function compileFirstConnectionCandidate(revision,tree,{negativeProfile=false,budgetQualification=false,dropWinner=false}={}){\n","after":"export async function compileFirstConnectionCandidate(revision,tree,{negativeProfile=false,budgetQualification=false,dropWinner=false,getWinner=false}={}){\n if(getWinner)assert(dropWinner&&!negativeProfile&&!budgetQualification,'GET observer requires ordinary positive prepared M');\n"},{"offset":11852,"before":" const m=await build({...options,entryPoints:['worker/mcp-own/finite.mjs'],...budget?{plugins:[budget.plugin()]}:dropWinner?{plugins:[dropMPlugin()]}:{}});\n","after":" const m=await build({...options,entryPoints:['worker/mcp-own/finite.mjs'],...budget?{plugins:[budget.plugin()]}:getWinner?{plugins:[getWinnerPlugin()]}:dropWinner?{plugins:[dropMPlugin()]}:{}});\n"},{"offset":72870,"before":"","after":"\nexport function createGetWinnerObserver() {\n  const cells=new WeakMap(), leases=new WeakMap(), facts=new WeakMap(), pending=new WeakMap();\n  const used=new WeakSet(), responsePrototype=Response.prototype, headersPrototype=Headers.prototype;\n  const header='x-afw-lab-get-winner';\n  const responseStatus=Object.getOwnPropertyDescriptor(responsePrototype,'status').get;\n  const responseHeaders=Object.getOwnPropertyDescriptor(responsePrototype,'headers').get;\n  const headerHas=headersPrototype.has, headerSet=headersPrototype.set;\n  let validating=null;\n  const guard=fn=>(...args)=>{try{return fn(...args);}catch{return null;}};\n  const tuple=(w,s,h)=>Number.isInteger(h)&&Number.isInteger(s)&&\n    ((w==='L'||w==='V')?h===503&&s===0:w==='S'?\n      (s===0?h===503:s>=400&&s<=599&&h===([400,401,403,404,405,413,429].includes(s)?s:503)):false);\n  const cell=l=>{const c=leases.get(l);return c&&!c.bad&&c.lease===l?c:null;};\n  function enter(p) {\n    if(cells.has(p)){cells.get(p).bad=true;return null;}\n    const c={p,lease:null,bad:false,sealed:false,w:'U',s:0,escaped:null,b:null,finished:false,forward:false};\n    cells.set(p,c);return c;\n  }\n  function bind(p,l) {\n    const c=cells.get(p);if(!c)return;\n    if(c.lease||leases.has(l)){c.bad=true;return;}\n    c.lease=l;leases.set(l,c);\n  }\n  function record(l,e,w,s) {\n    const c=cell(l);if(!c||c.sealed)return;\n    if((typeof e!=='object'&&typeof e!=='function')||e===null||facts.has(e)){c.bad=true;return;}\n    facts.set(e,{c,w,s});\n  }\n  function deadline(l,e) {record(l,e,'L',0);}\n  function denied(p,l,r,e,status) {\n    const c=cell(l);\n    if(!c||c.p!==p||!c.forward||Object.getPrototypeOf(r)!==responsePrototype)return;\n    record(l,e,'S',Number.isInteger(status)&&status>=400&&status<=599?status:0);\n  }\n  function validate(l,r) {\n    const c=cell(l);if(!c||!c.forward)return;\n    if(validating){validating.c.bad=true;c.bad=true;validating=null;return;}\n    if(Object.getPrototypeOf(r)!==responsePrototype)return;\n    validating={c,r};\n  }\n  function validationDenied(e) {\n    if(validating)record(validating.c.lease,e,'V',0);\n  }\n  function validationEnd(l,r) {\n    if(validating && (validating.c.lease!==l||validating.r!==r))validating.c.bad=true;\n    validating=null;\n  }\n  function race(l,e) {\n    const c=cell(l);if(!c)return;\n    if(c.sealed){c.bad=true;return;}\n    c.sealed=true;c.escaped=e;\n    const f=facts.get(e);\n    if(f?.c===c){c.w=f.w;c.s=f.s;}\n  }\n  function caught(p,l,e,b) {\n    const c=cell(l);\n    if(!c||c.p!==p||cells.get(p)!==c||!c.sealed||c.escaped!==e)return;\n    if(c.b||pending.has(b)||used.has(b)){c.bad=true;return;}\n    if(Object.getPrototypeOf(b)!==responsePrototype)return;\n    const h=Reflect.apply(responseStatus,b,[]);\n    if(!tuple(c.w,c.s,h))return;\n    const headers=Reflect.apply(responseHeaders,b,[]);\n    if(Object.getPrototypeOf(headers)!==headersPrototype||Reflect.apply(headerHas,headers,[header]))return;\n    c.b=b;pending.set(b,{c,p,l,h,headers});\n  }\n  function finish(c,p,l,b) {\n    if(!c||c.finished)return;\n    c.finished=true;\n    const entry=pending.get(b);\n    if(!entry||c.bad||cells.get(p)!==c||leases.get(l)!==c||entry.c!==c||entry.p!==p||entry.l!==l||c.b!==b||used.has(b))return;\n    used.add(b);\n    if(Object.getPrototypeOf(b)!==responsePrototype||Reflect.apply(responseStatus,b,[])!==entry.h||Reflect.apply(responseHeaders,b,[])!==entry.headers||\n      Object.getPrototypeOf(entry.headers)!==headersPrototype||Reflect.apply(headerHas,entry.headers,[header]))return;\n    Reflect.apply(headerSet,entry.headers,[header,'g1.'+entry.h+'.'+c.w+'.'+c.s]);\n  }\n  return Object.freeze({enter:guard(enter),bind:guard(bind),forward:guard((p,l)=>{const c=cell(l);if(c&&c.p===p)c.forward=true;}),\n    deadline:guard(deadline),denied:guard(denied),validate:guard(validate),validationDenied:guard(validationDenied),\n    validationEnd:guard(validationEnd),race:guard(race),caught:guard(caught),finish:guard(finish)});\n}\n\nexport function prepareGetWinner(name,source) {\n  if(name==='worker/mcp-own/finite.mjs') {\n    source=dropReplace(source,' const parent=createFiniteOwnerRequestLease(request);',\n      ' const parent=createFiniteOwnerRequestLease(request);let getResponse,getCell;');\n    source=dropReplace(source,\"if(path==='/connections/finite-prepare'){\\n   if(!['GET','POST'].includes(request.method))return finiteNativePending(405);\",\n      \"if(path==='/connections/finite-prepare'){let getMethod;\\n   if(!['GET','POST'].includes(getMethod=request.method))return finiteNativePending(405);if(getMethod==='GET')getCell=globalThis.__afwGetWinner?.enter(request);\");\n    source=dropReplace(source,'return await forwardFiniteOwnerChoice(input,parent.lease);',\n      'return getResponse=await forwardFiniteOwnerChoice(input,parent.lease);');\n    source=dropReplace(source,'finally{parent.finish();}',\n      'finally{parent.finish();globalThis.__afwGetWinner?.finish(getCell,request,parent.lease,getResponse);}');\n    return source+'\\nglobalThis.__afwGetWinner=('+createGetWinnerObserver.toString()+')();\\n';\n  }\n  if(name==='lib/mcp-qa-finite-owner-native-bridge.mjs') {\n    source=dropReplace(source,'if(readFiniteOwnerRequestContext(originalLease).root!==originalLease)fail();',\n      'if(readFiniteOwnerRequestContext(originalLease).root!==originalLease)fail();globalThis.__afwGetWinner?.bind(request,originalLease);');\n    source=dropReplace(source,'const response=await Reflect.apply(fetcher,stub,[forwarded]);',\n      'globalThis.__afwGetWinner?.forward(request,originalLease);const response=await Reflect.apply(fetcher,stub,[forwarded]);');\n    source=dropReplace(source,'if(!response.ok){try{fail([400,401,403,404,405,413,429].includes(response.status)?response.status:503);}',\n      'if(!response.ok){let getStatus;const getFail=status=>{try{fail(status);}catch(error){globalThis.__afwGetWinner?.denied(request,originalLease,response,error,getStatus);throw error;}};try{getFail([400,401,403,404,405,413,429].includes(getStatus=response.status)?response.status:503);}');\n    source=dropReplace(source,'return finiteNativeChoiceHtml(response,bytes);',\n      'globalThis.__afwGetWinner?.validate(originalLease,response);try{return finiteNativeChoiceHtml(response,bytes);}finally{globalThis.__afwGetWinner?.validationEnd(originalLease,response);}');\n    source=dropReplace(source,'globalThis.__afwDropM?.caught(request,originalLease,error,b);return b;',\n      'globalThis.__afwDropM?.caught(request,originalLease,error,b);globalThis.__afwGetWinner?.caught(request,originalLease,error,b);return b;');\n    return source;\n  }\n  assert.equal(name,'lib/mcp-qa-finite-owner-native-wire.mjs');\n  source=dropReplace(source,'globalThis.__afwDropM?.deadline(lease,error);reject(error);',\n    'globalThis.__afwDropM?.deadline(lease,error);globalThis.__afwGetWinner?.deadline(lease,error);reject(error);');\n  source=dropReplace(source,'try{return await Promise.race([actual,first,deadline]);}',\n    'try{return await Promise.race([actual,first,deadline]);}catch(error){globalThis.__afwGetWinner?.race(lease,error);throw error;}');\n  const start=source.indexOf('export function finiteNativeChoiceHtml(response,bytes){');\n  assert(start>=0 && source.indexOf('export function finiteNativeChoiceHtml(response,bytes){',start+1)<0);\n  const original=source.slice(start);\n  assert.equal((original.match(/finiteNativeFailure\\(\\)/g)||[]).length,4);\n  const changed=original.replaceAll('finiteNativeFailure()','getDenial()').replace(\n    'export function finiteNativeChoiceHtml(response,bytes){',\n    'export function finiteNativeChoiceHtml(response,bytes){const getDenial=()=>{try{finiteNativeFailure();}catch(error){globalThis.__afwGetWinner?.validationDenied(error);throw error;}};');\n  return source.slice(0,start)+changed;\n}\n\nfunction getWinnerPlugin() {\n  return {name:'first-get-winner-positive-M',setup(build) {\n    build.onLoad({filter:/(?:worker\\/mcp-own\\/finite|lib\\/mcp-qa-finite-owner-native-(?:bridge|wire))\\.mjs$/},async args=>{\n      const name=args.path.slice(process.cwd().length+1);\n      const prepared=prepareDropM(name,await readFile(args.path,'utf8'));\n      const before={\"worker/mcp-own/finite.mjs\":\"922428af9ac17d0f11ad2928c8ad60b88b8b78fa8729cafd512e407d2ec9ab67\",\"lib/mcp-qa-finite-owner-native-bridge.mjs\":\"97856b44f9b46f4110cb3e23e85d047cae895d2f39ed6d027c528f9a1c373633\",\"lib/mcp-qa-finite-owner-native-wire.mjs\":\"d0b88ce5a6319ff7559f13cda5d9aea6be6bb226fc775422547abce923bab3fe\"};\n      assert.equal(digest(prepared),before[name],'unchanged prepared DROP input');\n      return {contents:prepareGetWinner(name,prepared),loader:'js'};\n    });\n  }};\n}\n\nexport function getWinnerTuple(w,s,h) {\n  if(!Number.isInteger(s)||!Number.isInteger(h))return false;\n  if(w==='U')return s===0&&h===0;\n  if(w==='L'||w==='V')return s===0&&h===503;\n  return w==='S' && (s===0?h===503:s>=400&&s<=599&&h===([400,401,403,404,405,413,429].includes(s)?s:503));\n}\nexport function createGetWinnerHost(main,directRoute=()=>false,DispatchResponse) {\n  const tokens=new WeakMap(),seen=new WeakSet(),empty=()=>({w:'U',s:0,h:0});\n  let current=null,poisoned=false;\n  const safe=fn=>(...args)=>{try{return fn(...args);}catch{poisoned=true;return null;}};\n  function begin(label) {\n    if(current||poisoned||!label||label.id!=='C2T1_SCOPE_MISSING'||tokens.has(label)){poisoned=true;return null;}\n    const entry={label,response:null,calls:0,done:false,value:empty()};\n    const token=Object.freeze({capture:safe((f,r,status)=>{\n      entry.calls++;\n      if(poisoned||entry!==current||entry.done||f!==main||entry.calls!==1||label.id!=='C2T1_SCOPE_MISSING'||seen.has(r)){poisoned=true;return;}\n      seen.add(r);entry.response=r;\n      if(directRoute()!==true || typeof DispatchResponse!=='function' || !(r instanceof DispatchResponse) || !Number.isInteger(status) || status===200)return;\n      const raw=r.headers.get('x-afw-lab-get-winner');\n      const m=/^g1\\.([45][0-9]{2})\\.([LSV])\\.([45][0-9]{2}|0)$/.exec(raw??'');\n      if(!m||Number(m[1])!==status||!getWinnerTuple(m[2],Number(m[3]),status))return;\n      entry.value={w:m[2],s:Number(m[3]),h:status};\n    })});\n    tokens.set(label,{entry,token});current=entry;return token;\n  }\n  function finish(label) {\n    const item=tokens.get(label);\n    if(!item||item.entry!==current||poisoned){poisoned=true;return;}\n    item.entry.done=true;current=null;\n  }\n  function take(label,f) {\n    const item=tokens.get(label);\n    if(item)tokens.delete(label);\n    if(poisoned||current||!item||f!==main||label.id!=='C2T1_SCOPE_MISSING'||!item.entry.done||item.entry.calls!==1||!item.entry.response)return empty();\n    return item.entry.value;\n  }\n  return Object.freeze({begin:safe(begin),finish:safe(finish),take:safe(take),poison:safe(()=>{poisoned=true;})});\n}\n"}]},{"preimage":"955fa904a89733fabfa5c73736f59922b6e58023","after":{"path":"docs/superpowers/source-lab/c2-get-winner-dependent/body-10-get-winner.txt","mode":"100644","type":"blob","kind":"DRAFT_SOURCE_AFTERIMAGE","blob":"9ffce28ba28961937c4f24f1cc00eb8d899bc495","bytes":98851,"sha256":"7c8680d6b86b1ccc0acdcfecb4d8e4312e6d6971f36b00bd6dcf88c289309604","fullReadback":true},"operations":[{"offset":6874,"before":" mark('M-compile-start');const firstCandidate=firstConnection?await compileFirstConnectionCandidate(M,TREE,{negativeProfile,budgetQualification,dropWinner:dropWinner||dropCompilerOnly}):null;mark