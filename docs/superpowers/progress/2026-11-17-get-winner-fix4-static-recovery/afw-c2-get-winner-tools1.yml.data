name: AFW first finite GET focused tooling
on:
  push:
    branches:
      - lab/afw-c2-get-winner-20261117-tools1
permissions:
  contents: read
jobs:
  c2-get-winner-tools:
    if: >-
      false &&
      github.repository == 'tokenizartinfo-ops/agent-friendly-web' &&
      github.event_name == 'push' &&
      github.ref == 'refs/heads/lab/afw-c2-get-winner-20261117-tools1' &&
      github.run_attempt == 1 &&
      github.event.head_commit.message == 'AFW-C2-GET-WINNER-TOOLS1-ONEUSE-20261117'
    runs-on: ubuntu-24.04
    timeout-minutes: 7
    steps:
      - name: Read the exact one-use lab head
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
          fetch-depth: 2
      - name: Use the fixed Node runtime
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 22.23.4
      - name: Check the tooling controller syntax
        shell: bash
        run: |
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/run-get-winner-tools.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/startup-diagnostics.test.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/startup-diagnostics.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/startup-bootstrap.mjs
          node --check docs/superpowers/source-lab/c2-t1-drop-winner-diag4/read-progress.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/native-tools-child.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/model-get-controls.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/native-get-ordinary-controls.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/get-winner-collection-adapters.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/test-corpus-adapter.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/factory-get-model-controls.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/startup-retention-bootstrap.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/retention-tools-child.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/native-retention-controls.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/retention-component-entry.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/component-get-observer.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/startup-fault-bootstrap.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/fault-tools-child.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/native-fixed-fault-controls.mjs
          node --check docs/superpowers/source-lab/c2-get-winner-dependent/native-transport-controls.mjs
          node --input-type=module --check < docs/superpowers/source-lab/c2-get-winner-dependent/body-08-get-winner.txt
          node --input-type=module --check < docs/superpowers/source-lab/c2-get-winner-dependent/body-09-get-winner.txt
          node --input-type=module --check < docs/superpowers/source-lab/c2-get-winner-dependent/body-10-get-winner.txt
          node --input-type=module --check < docs/superpowers/source-lab/c2-get-winner-dependent/body-09-fixed-fault-tool.txt
          node --input-type=module --check < docs/superpowers/source-lab/c2-get-winner-dependent/component-stage-work.txt
          node --input-type=module --check < docs/superpowers/source-lab/c2-get-winner-dependent/component-wire-off.txt
          node --input-type=module --check < docs/superpowers/source-lab/c2-get-winner-dependent/component-wire-on.txt
      - name: Check the 46 startup metadata controls
        shell: bash
        run: node docs/superpowers/source-lab/c2-get-winner-dependent/startup-diagnostics.test.mjs
      - name: Install only the existing locked dependencies
        shell: bash
        run: npm ci --ignore-scripts --no-audit --no-fund
      - name: Exercise only the sealed three-group tool schedule
        id: source
        shell: bash
        run: |
          set +e
          # Includes process startup, every async cleanup and all local publication readbacks.
          python3 - <<'PY'
          import subprocess
          import sys
          import time
          deadline = time.monotonic_ns() + 330_000_000_000
          child = subprocess.Popen(["node", "docs/superpowers/source-lab/c2-get-winner-dependent/run-get-winner-tools.mjs"])
          try:
              code = child.wait(timeout=max(0, deadline - time.monotonic_ns()) / 1_000_000_000)
          except subprocess.TimeoutExpired:
              # The run is irreversibly ineligible. Let its ongoing cleanup finish inside the job ceiling.
              print("AFW_GET_TOOLS_DEADLINE", flush=True)
              child.wait()
              sys.exit(124)
          sys.exit(124 if time.monotonic_ns() >= deadline else code if 0 <= code <= 255 else 1)
          PY
          result=$?
          echo "controller_exit=$result" >> "$GITHUB_OUTPUT"
          exit "$result"
      - name: Preserve the bounded focused tool evidence
        if: ${{ success() && steps.source.outcome == 'success' && steps.source.outputs.controller_exit == '0' }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: afw-c2-get-winner-tools
          path: output/get-winner-tools.json
          if-no-files-found: error
          retention-days: 7
      - name: Preserve the bounded startup diagnostic
        if: ${{ failure() && steps.source.outcome == 'failure' && steps.source.outputs.controller_exit == '1' }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: afw-c2-get-winner-startup-diagnostic
          path: output/get-winner-startup-diagnostic.json
          if-no-files-found: ignore
          retention-days: 7
