name: AFW independent public GET winner controls
on:
  push:
    branches:
      - lab/afw-c2-own-20261117-get-winner-tools
permissions:
  contents: read
jobs:
  c2-own-get-winner-tools:
    if: >-
      github.repository == 'tokenizartinfo-ops/agent-friendly-web' &&
      github.event_name == 'push' &&
      github.ref == 'refs/heads/lab/afw-c2-own-20261117-get-winner-tools' &&
      github.run_attempt == 1 &&
      github.event.head_commit.message == 'AFW-C2-OWN-GET-WINNER-TOOLS-ONEUSE-20261117'
    runs-on: ubuntu-24.04
    timeout-minutes: 7
    steps:
      - name: Read exact OWN one-use lab head
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
          fetch-depth: 2
          persist-credentials: false
      - name: Use fixed Node for OWN
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '22.23.4'
          package-manager-cache: false
      - name: Check independent OWN syntax
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          test "$(git rev-list --parents -n 1 HEAD)" = "$GITHUB_SHA 6791ce1bab9372e206d3c7b42b3e1394dc6e0c68"
          test "$(git rev-parse HEAD^)" = "6791ce1bab9372e206d3c7b42b3e1394dc6e0c68"
          test "$(git rev-parse HEAD^:)" = "62e78926635d6b74f288d6c0d69e0f2516306989"
          test "$(git show -s --format=%B HEAD)" = "AFW-C2-OWN-GET-WINNER-TOOLS-ONEUSE-20261117"
          test ! -e output/c2-own-get-winner-tools.json
          node --check docs/superpowers/root-own/c2-get-winner-dependent/bindings.mjs
          node --check docs/superpowers/root-own/c2-get-winner-dependent/get-winner.mjs
          node --check docs/superpowers/root-own/c2-get-winner-dependent/reader.mjs
          node --check docs/superpowers/root-own/c2-get-winner-dependent/controls.mjs
          node --check docs/superpowers/root-own/c2-get-winner-dependent/run-controls.mjs
          node --check docs/superpowers/root-own/c2-t1-finite-get-diag3/finite-get.mjs
          node --check docs/superpowers/root-own/c2-t1-finite-get-diag3/bound-transport.mjs
          node --check docs/superpowers/root-own/c2-t1-finite-get-diag3/legacy/fixed.mjs
          node --check docs/superpowers/root-own/c2-t1-finite-get-diag3/legacy/shape.mjs
          node --check docs/superpowers/root-own/c2-t1-finite-get-diag3/legacy/partial.mjs
          node --check docs/superpowers/root-own/c2-t1-finite-get-diag3/legacy/first-failure.mjs
          node --check docs/superpowers/root-own/c2-t1-drop-winner-diag4/bindings.mjs
          node --check docs/superpowers/root-own/c2-t1-drop-winner-diag4/drop-winner.mjs
          node --check docs/superpowers/root-own/c2-t1-drop-winner-diag4/reader.mjs
          node --check docs/superpowers/root-own/c2-t1-drop-winner-diag4/occurrence.mjs
      - name: Validate independent public GET reader controls
        shell: bash
        run: node docs/superpowers/root-own/c2-get-winner-dependent/run-controls.mjs
      - name: Preserve independent OWN control result
        if: ${{ success() }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: afw-c2-own-get-winner-tools
          path: output/c2-own-get-winner-tools.json
          if-no-files-found: error
          retention-days: 7
