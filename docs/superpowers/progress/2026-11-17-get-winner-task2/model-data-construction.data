  if (defect==='trusted-step') trusted.commandStepNumber=7;
  if (defect==='trusted-artifact') trusted.artifactId=a+1;
  const transport={runId:r,jobId:j,rawLog:t2canonicalLog(out,custody)};
  if (defect==='outside-log-window') transport.rawLog=transport.rawLog.replaceAll('01:03:30Z','01:04:10Z');
  if (defect==='fault-frame') transport.rawLog=transport.rawLog.replace(t2marker+'OUTCOME',t2marker+'FAULT');
  if (defect==='noncanonical-frame') transport.rawLog=t2canonicalLog(out,custody,t2nom.command,' '+t2json(out));
  if (p.log===null) transport.rawLog=null;
  const item={id:a,name:t2nom.artifact.name,expired:false,size_in_bytes:0,created_at:'2041-04-05T01:04:10Z',
    expires_at:'2041-04-12T01:04:10Z',workflow_run:{id:r,head_sha:head,head_branch:t2nom.branch},digest:null};
  const artifact={runId:r,jobId:j,listing:{total_count:1,artifacts:[item]},artifactId:a,fileName:t2nom.artifact.fileName,
