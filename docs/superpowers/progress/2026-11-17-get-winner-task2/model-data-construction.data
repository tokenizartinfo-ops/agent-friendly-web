// t2hash and t2zip are Node builtins crypto and zlib. nodeRepl.write reports only DATA metadata.

const t2sha = (value, alg = 'sha256') => t2hash.createHash(alg).update(value).digest('hex');
const t2git = value => t2sha(Buffer.concat([Buffer.from('blob ' + Buffer.byteLength(value) + '\0'), Buffer.from(value)]), 'sha1');
const t2json = value => JSON.stringify(value);
const t2line = value => t2json(value) + '\n';
const t2copy = value => JSON.parse(t2json(value));
const t2crc = value => {let c = ~0; for (const v of value) {c ^= v; for (let bit = 0; bit < 8; bit++) c = c >>> 1 ^ (c & 1 ? 0xedb88320 : 0);} return ~c >>> 0;};
function t2archive(fileName, text, defect = null) {
  const name = Buffer.from(fileName), data = Buffer.from(text);
  let compressed = t2zip.deflateRawSync(data);
  if (defect === 'trailing-deflate') compressed = Buffer.concat([compressed, Buffer.from([0])]);
  const crc = t2crc(data), flags = 8 | 2048, method = 8;
  const l = Buffer.alloc(30), dd = Buffer.alloc(16), c = Buffer.alloc(46), e = Buffer.alloc(22);
  l.writeUInt32LE(0x04034b50, 0); l.writeUInt16LE(20, 4); l.writeUInt16LE(flags, 6); l.writeUInt16LE(method, 8); l.writeUInt16LE(name.length, 26);
  dd.writeUInt32LE(0x08074b50, 0); dd.writeUInt32LE(defect === 'bad-dd' ? (crc ^ 1) >>> 0 : crc, 4); dd.writeUInt32LE(compressed.length, 8); dd.writeUInt32LE(data.length, 12);
  c.writeUInt32LE(0x02014b50, 0); c.writeUInt16LE(20, 4); c.writeUInt16LE(20, 6); c.writeUInt16LE(flags, 8); c.writeUInt16LE(method, 10);
  c.writeUInt32LE(defect === 'bad-crc' ? (crc ^ 1) >>> 0 : crc, 16); c.writeUInt32LE(compressed.length, 20); c.writeUInt32LE(data.length, 24); c.writeUInt16LE(name.length, 28);
  if (defect === 'bad-crc') dd.writeUInt32LE((crc ^ 1) >>> 0, 4);
  e.writeUInt32LE(0x06054b50, 0); e.writeUInt16LE(1, 8); e.writeUInt16LE(1, 10); e.writeUInt32LE(c.length + name.length, 12);
  e.writeUInt32LE(l.length + name.length + compressed.length + dd.length, 16);
  return Buffer.concat([l, name, compressed, dd, c, name, e]);
}
const t2cloneCustody = t2copy(JSON.parse(t2old.input.artifact.payloadText).custody);
const t2schemaFamily = 'afw.c2-get-winner-observation1';
const t2marker = 'AFW_C2_GET_WINNER_OBSERVATION1_';
const t2artifactName = 'afw-c2-model-get-winner';
const t2modelPrefix = 'synthetic/model/get-winner/';
const t2nom = {
  branch:'lab/model/get-winner', message:'SYNTHETIC-ONLY-GET-WINNER',
  workflow:'.github/workflows/model-get-winner.yml', job:'synthetic-lab', prefix:t2modelPrefix,
