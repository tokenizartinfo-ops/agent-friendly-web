  const intervals = [['00:00','00:05'],['00:05','00:10'],['00:10','00:15'],['00:15','00:30'],['00:30','03:40'],['03:40','04:15']];
  job.steps=t2nom.requiredSteps.map((name,i)=>({number:i+2,name,status:'completed',conclusion:'success',
    started_at:'2041-04-05T01:'+intervals[i][0]+'Z',completed_at:'2041-04-05T01:'+intervals[i][1]+'Z'}));
  Object.assign(commit,{sha:head,tree:{sha:treeSha},message:t2nom.message,parents:[{sha:t2model.base}]});
  const tree = {sha:treeSha,truncated:false,tree:t2edges.map(x=>({path:x.path,mode:x.mode,type:x.type,sha:x.blob,size:x.bytes}))};
  tree.tree.push(t2copy(oldInput.tree.tree.at(-1)));
