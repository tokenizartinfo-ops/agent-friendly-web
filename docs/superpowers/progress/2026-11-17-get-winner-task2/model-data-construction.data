    sourceIndexBlob:t2edges[0].blob,proposalIndexHash:t2edges[0].sha256,selectionHash:t2model.selectionHash,
    head,tree:treeSha,runId:String(r),runAttempt:1,job:t2nom.job,node:'v22.23.4'};
  const custody = {...t2cloneCustody,schema:t2schemaFamily+'-custody.v1',context};
  const events = t2caseIds.slice(0,14).flatMap((id,i) => [
    t2event(4*i+1,id,'action','enter'),t2event(4*i+2,id,'action','return'),
