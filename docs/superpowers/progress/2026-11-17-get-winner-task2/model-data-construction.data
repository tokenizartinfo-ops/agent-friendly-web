  const expected = {repository:'tokenizartinfo-ops/agent-friendly-web',branch:t2nom.branch,workflowPath:t2nom.workflow,
    oneUseMessage:t2nom.message,job:t2nom.job,parent:t2model.base,head,tree:treeSha,runId:r,jobId:j,requiredSteps:t2nom.requiredSteps};
