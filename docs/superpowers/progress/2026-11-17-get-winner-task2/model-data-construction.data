const t2noSample = {value:'UNKNOWN',reason:'JOURNAL_UNRESOLVED',countSequence:null};
const t2event = (sequence,id,operation,edge,error=null) => ({sequence,elapsedMs:sequence,id,operation,edge,error});
const t2failure = site => ({name:'AssertionError',code:'ERR_ASSERTION',site});
