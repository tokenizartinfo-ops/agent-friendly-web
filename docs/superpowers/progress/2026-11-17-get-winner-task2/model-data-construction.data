  artifact.archiveBase64 = zip.toString('base64');
  Object.assign(artifact.listing.artifacts[0],{size_in_bytes:zip.length,digest:'sha256:'+t2sha(zip)});
};
const t2canonicalLog = (out,custody,command = t2nom.command,outWire=t2json(out)) =>
  '2041-04-05T01:00:31Z ##[group]Run '+command+'\n'+
  '2041-04-05T01:00:31Z ##[endgroup]\n'+
  '2041-04-05T01:03:30Z '+t2marker+'CUSTODY '+t2json(custody)+'\n'+
  '2041-04-05T01:03:30Z '+t2marker+'OUTCOME '+outWire+'\n';
const t2modelRunId = 99505001, t2modelJobId = 99505002, t2modelArtifactId = 99505003;
const t2modelStepNumber = 6;
const t2oldPacket = {input:t2old.input,trusted:t2old.trusted};
