if(!fault && cleanup==='REMOVED'){
 try{
   const artifact = {schema:'AFW.GET_WINNER.FOCUSED_TOOLS/1',head:context.head,tree:context.tree,runId:context.runId,
     attempt:1,job:config.job,stage:'FOCUSED_TOOL_CONTROLS',observation,childExit:0,fixtureIndex:pins.fixtureIndex.blob,
     sourceIndex:pins.index.blob,schedule:pins.schedule.blob,preflightProcesses:pfCount,toolProcesses:3,guardedNodeProcesses:4,groups:groupProof,targetHashesRechecked:true,toolInputsRechecked:true,
     targetHashes:{beforeSha256:beforeHashes,afterSha256:afterHashes},
     ownedTempRemoved:checks.ownTempRemoved,SourceQualified:false,Task1Pass:false,nonclaims:flags};
   const out=join(workspace,config.artifact),bytes=Buffer.from(JSON.stringify(artifact)+'\n');
   await publishFile(out,bytes,24577);
   remain(330000);
   console.info('AFW_GET_WINNER_FOCUSED_TOOL_CONTROLS');
   process.exitCode = 0;
 } catch { fault={phase:'publish',substep:'PUBLISH',reason:'PUBLICATION_INVALID'}; }
}
if (fault || cleanup==='FAILED') {
  process.exitCode=1;
  console.error('GET_TOOLS_PREREQUISITE '+(fault?fault.phase+' '+fault.reason:'cleanup CLEANUP_INVALID'));
  if(context && controllerPin && fault?.phase!=='publish') {
    try {
      const ids={controller:controllerPin,bootstrap:pins[activeGroup.bootstrapKey].blob,helper:pins.startupHelper.blob,
        child:pins[activeGroup.childKey].blob,sourceIndex:pins.index.blob,fixtureIndex:pins.fixtureIndex.blob,startupFixtures:pins.startupFixtures.blob};
      const raw=diagnostic(context,ids,fault,cleanup,counts,children,bootstrap);
      await publishFile(join(workspace,'output/get-winner-startup-diagnostic.json'),Buffer.from(raw));
    } catch { console.error('STARTUP_DIAGNOSTIC_UNAVAILABLE'); }
  }
}
