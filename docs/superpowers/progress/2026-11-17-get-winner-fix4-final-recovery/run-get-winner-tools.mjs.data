  }
  beforeHashes=await adapters.measureTargets(target,index.entries);
  const schedule=JSON.parse(files.schedule),groups=[
    {id:'ordinary-model',bootstrapKey:'startupBootstrap',childKey:'child',startupPrefix:''},
    {id:'retention',bootstrapKey:'retentionBootstrap',childKey:'retentionChild',startupPrefix:'retention-'},
    {id:'fault-transport',bootstrapKey:'faultBootstrap',childKey:'faultChild',startupPrefix:'fault-'}
