{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-friendly-web-public-mcp",
  "main": "worker/mcp/index.mjs",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "agent-friendly-web-public-mcp-staging",
      "workers_dev": true
    },
    "production": {
      "name": "agent-friendly-web-public-mcp",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "mcp.agentfriendlyweb.dev",
          "custom_domain": true
        }
      ]
    }
  }
}
