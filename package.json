{
  "name": "agent-friendly-web",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "afw": "./bin/afw.mjs",
    "agent-friendly-web": "./bin/afw.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "generate:crawler-catalog": "node scripts/generate-crawler-catalog.mjs",
    "generate:okf": "node scripts/generate-okf-public.mjs",
    "validate:okf": "node scripts/validate-okf-public.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "web:compatibility": "vinext check",
    "web:deploy:dry-run": "npx @vinext/cloudflare deploy --env canary --dry-run",
    "web:smoke:local": "node scripts/smoke-cloudflare-native-local.mjs --base-url http://localhost:8788 --mode local",
    "web:smoke:canary-edge": "node scripts/smoke-cloudflare-native-local.mjs --base-url https://canary.agentfriendlyweb.dev --mode access-edge",
    "web:preflight:canary": "node scripts/preflight-cloudflare-native-canary.mjs --input docs/evidence/cloudflare-native-canary-metadata.json",
    "web:verify:production": "node scripts/smoke-cloudflare-native-local.mjs --base-url https://agentfriendlyweb.dev --mode public-edge",
    "web:audit:stability": "node scripts/audit-cloudflare-native-stability.mjs",
    "web:d1:migrations:canary": "wrangler d1 migrations apply agent-friendly-web-web-canary --remote --config wrangler.jsonc --env canary",
    "web:d1:migrations:production": "wrangler d1 migrations apply agent-friendly-web-web-production --remote --config wrangler.jsonc --env production",
    "web:deploy:canary": "npx @vinext/cloudflare deploy --env canary",
    "web:deploy:production:dry-run": "npx @vinext/cloudflare deploy --env production --dry-run",
    "web:deploy:production": "npx @vinext/cloudflare deploy --env production",
    "web:smoke:production": "node scripts/smoke-cloudflare-native-local.mjs --base-url https://agentfriendlyweb.dev --mode public-edge",
    "web:compare:precutover-local": "node scripts/compare-cloudflare-native-public-origin.mjs --baseline-url https://agentfriendlyweb.dev --candidate-url http://127.0.0.1:8788",
    "web:types": "wrangler types --config wrangler.jsonc --env canary --env-interface CloudflareEnv",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "test": "node --test test/*.test.mjs",
    "smoke:mcp": "node scripts/smoke-public-mcp.mjs",
    "mcp:dev": "npx --yes wrangler@4.127.0 dev --config wrangler.mcp.jsonc --env staging --port 8791",
    "mcp:deploy:dry-run": "npx --yes wrangler@4.127.0 deploy --config wrangler.mcp.jsonc --env staging --dry-run",
    "mcp:deploy:staging": "npx --yes wrangler@4.127.0 deploy --config wrangler.mcp.jsonc --env staging",
    "mcp:deploy:production": "npx --yes wrangler@4.127.0 deploy --config wrangler.mcp.jsonc --env production",
    "contact:dev": "npx --yes wrangler@4.127.0 dev --config wrangler.contact.jsonc --env staging --port 8792",
    "contact:deploy:dry-run": "npx --yes wrangler@4.127.0 deploy --config wrangler.contact.jsonc --env staging --dry-run",
    "contact:deploy:staging": "npx --yes wrangler@4.127.0 deploy --config wrangler.contact.jsonc --env staging",
    "email:inbound:preflight": "node scripts/preflight-email-inbound-canary.mjs --input",
    "email:outbound:preflight": "node scripts/preflight-email-outbound-canary.mjs --input",
    "cli": "node bin/afw.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.10",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.128.0",
    "yaml": "2.9.0"
  },
  "type": "module"
}
