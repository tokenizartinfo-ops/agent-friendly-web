{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfriendlyweb.dev/schemas/draft-pr-plan.v1.json",
  "title": "Agent Friendly Web Draft PR Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "plan_id",
    "capsule_id",
    "capsule_digest",
    "idempotency_key",
    "repository",
    "base_branch",
    "branch",
    "title",
    "body",
    "draft",
    "auto_merge",
    "executed",
    "requested_permissions",
    "touched_paths",
    "changes",
    "post_checks",
    "rollback",
    "limits"
  ],
  "properties": {
    "contract": { "const": "agentfriendly.draft-pr-plan.v1" },
    "plan_id": { "type": "string", "pattern": "^afwpr_[a-f0-9]{24}$" },
    "capsule_id": { "type": "string", "pattern": "^afwcap_[a-f0-9]{24}$" },
    "capsule_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "idempotency_key": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
    "base_branch": { "type": "string", "minLength": 1, "maxLength": 100 },
    "branch": { "type": "string", "pattern": "^afw/capsule-[a-f0-9]{12}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "body": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "draft": { "const": true },
    "auto_merge": { "const": false },
    "executed": { "const": false },
    "requested_permissions": {
      "const": ["contents:write", "pull_requests:write"]
    },
    "touched_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 159 }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "operation", "media_type", "content", "content_sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 159 },
          "operation": { "enum": ["create", "replace", "delete"] },
          "media_type": { "type": "string", "minLength": 3, "maxLength": 80 },
          "content": { "type": "string", "maxLength": 131072 },
          "content_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "expected_previous_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "post_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url", "expected_status"],
        "properties": {
          "type": { "const": "public_http" },
          "url": { "type": "string", "format": "uri" },
          "expected_status": { "enum": [200, 404] },
          "expected_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "scope", "touched_paths", "previous_hashes"],
      "properties": {
        "strategy": { "const": "revert_pull_request" },
        "scope": { "const": "capsule_paths_only" },
        "touched_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 159 }
        },
        "previous_hashes": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
