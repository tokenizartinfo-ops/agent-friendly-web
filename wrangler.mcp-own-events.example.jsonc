{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-friendly-web-own-events-local",
  "main": "output/mcp-own-worker/index.mjs",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {
    "AFW_DELEGATED_OAUTH_ENABLED": "false",
    "AFW_DOSSIER_EVENTS_ENABLED": "false",
    "AFW_OAUTH_ISSUER": "https://private.example.invalid",
    "AFW_OAUTH_RESOURCE": "https://private.example.invalid/mcp"
  },
  // Local placeholders only. Never apply this file to an existing canary.
  "d1_databases": [{"binding": "DB", "database_name": "afw-own-events-local", "database_id": "00000000-0000-0000-0000-000000000000", "remote": false}],
  "kv_namespaces": [{"binding": "OAUTH_KV", "id": "00000000000000000000000000000000", "remote": false}],
  "durable_objects": {"bindings": [{"name": "AFW_DOSSIER_EVENTS_NODE", "class_name": "AfwOwnEventNode"}]},
  "exports": {
    "default": {"type": "worker"},
    "AfwNodeControl": {"type": "worker"},
    "AfwOwnEventNode": {"type": "durable-object", "storage": "sqlite"}
  }
  // No Container app in this closed local config. Wrangler4.128 rejects the
  // current provider durable_object scheduling policy. Scope its API app
  // separately before any activation; do not substitute a Docker image.
}
