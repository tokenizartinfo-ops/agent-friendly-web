{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-friendly-web-web",
  "account_id": "85d0d5dadac3341a564f22ce885e9eec",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-friendly-web-web-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "replace-before-remote-deploy.cloudflareaccess.com",
    "ACCESS_AUD": "replace-before-remote-deploy",
    "AFW_CANARY_DIAGNOSTICS_ENABLED": "false",
    "AFW_REMOTE_DEPLOY_ENABLED": "false",
    "AFW_EMAIL_REVIEW_READY_ENABLED": "false",
    "AFW_SYNTHETIC_CONTACT_ENABLED": "false",
    "AFW_SYNTHETIC_COMMERCIAL_REVIEW_ENABLED": "false",
    "AFW_SYNTHETIC_CRM_PERSISTENCE_ENABLED": "false",
    "AFW_SYNTHETIC_CRM_READONLY_ENABLED": "false",
    "AFW_SYNTHETIC_PRIVACY_LIFECYCLE_ENABLED": "false",
    "AFW_REAL_CONTACT_ENABLED": "false",
    "AFW_PRIVACY_REQUESTS_ENABLED": "false",
    "AFW_RETENTION_JOBS_ENABLED": "false",
    "AFW_PRODUCT_UPDATES_ENABLED": "false"
  },
  "env": {
    "canary": {
      "name": "agent-friendly-web-web-canary",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-friendly-web-web-canary",
          "database_id": "2b518988-eacb-4c31-b760-4e58c3c0285b",
          "migrations_dir": "drizzle"
        }
      ],
      "ratelimits": [
        {
          "name": "AFW_EMAIL_REVIEW_READY_RATE_LIMITER",
          "namespace_id": "1895760673",
          "simple": {
            "limit": 1,
            "period": 60
          }
        },
        {
          "name": "AFW_SYNTHETIC_CONTACT_RATE_LIMITER",
          "namespace_id": "1895760674",
          "simple": {
            "limit": 3,
            "period": 60
          }
        }
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "EMAIL_REVIEW_READY",
            "type": "inherit"
          }
        ]
      },
      "vars": {
        "ACCESS_TEAM_DOMAIN": "tokenizart.cloudflareaccess.com",
        "ACCESS_AUD": "5e6f80fdd77e026d6e9f513d4614d22e10cba0f7a90ea4bf7a10b27d6de67a45",
        "AFW_CANARY_DIAGNOSTICS_ENABLED": "true",
        "AFW_REMOTE_DEPLOY_ENABLED": "false",
        "AFW_EMAIL_REVIEW_READY_ENABLED": "false",
        "AFW_SYNTHETIC_CONTACT_ENABLED": "false",
        "AFW_SYNTHETIC_COMMERCIAL_REVIEW_ENABLED": "false",
        "AFW_SYNTHETIC_CRM_PERSISTENCE_ENABLED": "false",
        "AFW_SYNTHETIC_CRM_READONLY_ENABLED": "false",
        "AFW_SYNTHETIC_PRIVACY_LIFECYCLE_ENABLED": "false",
        "AFW_REAL_CONTACT_ENABLED": "false",
        "AFW_PRIVACY_REQUESTS_ENABLED": "false",
        "AFW_RETENTION_JOBS_ENABLED": "false",
        "AFW_PRODUCT_UPDATES_ENABLED": "false",
        "AFW_SYNTHETIC_CONTACT_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "AFW_SYNTHETIC_CONTACT_TURNSTILE_SECRET": "1x0000000000000000000000000000000AA"
      }
    },
    "production": {
      "name": "agent-friendly-web-web-production",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-friendly-web-web-production",
          "database_id": "d26fc9d2-df5a-4957-8e58-cc4c945faad8",
          "migrations_dir": "drizzle"
        }
      ],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "tokenizart.cloudflareaccess.com",
        "ACCESS_AUD": "afac57a0e7660c20cffe344cd331a2d42a37eb1440d6b20bdbca9d6ad89708ac",
        "AFW_CANARY_DIAGNOSTICS_ENABLED": "false",
        "AFW_REMOTE_DEPLOY_ENABLED": "false",
        "AFW_EMAIL_REVIEW_READY_ENABLED": "false",
        "AFW_SYNTHETIC_CONTACT_ENABLED": "false",
        "AFW_SYNTHETIC_COMMERCIAL_REVIEW_ENABLED": "false",
        "AFW_SYNTHETIC_CRM_PERSISTENCE_ENABLED": "false",
        "AFW_SYNTHETIC_CRM_READONLY_ENABLED": "false",
        "AFW_SYNTHETIC_PRIVACY_LIFECYCLE_ENABLED": "false",
        "AFW_REAL_CONTACT_ENABLED": "false",
        "AFW_PRIVACY_REQUESTS_ENABLED": "false",
        "AFW_RETENTION_JOBS_ENABLED": "false",
        "AFW_PRODUCT_UPDATES_ENABLED": "false"
      }
    }
  }
}
